{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "guajirago/functions"
  },
  "emulators": {
    "firestore": { "port": 8085 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false }
  }
}
