rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── ¿QUIEN ES DEL PANEL? ──────────────────────────────────────────────────
    // Se pregunta por el campo 'rol' de la ficha de quien llama. Desde la REGLA 1
    // ese campo ya no lo puede escribir el dueño de la ficha, así que la respuesta
    // es de fiar. Usa .get('rol','') a propósito: medido el 23-ago-2026, 8 de las
    // 10 fichas NO tienen el campo, y preguntar por un campo que no existe da error.
    function esAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '') == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '') == 'superadmin'
      );
    }

    // ── REGLA 9 · ¿ESTE NEGOCIO ES EL SUYO? ─────────────────────────────────
    // En un restaurante o una agencia trabajan DOS clases de personas, y entran
    // con cuentas DISTINTAS:
    //   · el dueño    — su cuenta ES el negocio: request.auth.uid == el id.
    //   · el empleado — tiene cuenta aparte, y su uid NO se parece en nada al
    //     del negocio. Quien dice a qué negocio pertenece es su ficha en
    //     'empleados/{uid}'. Medido el 24-ago-2026: hay 1 empleado real (JUAN,
    //     del restaurante TWjNDorw...), así que la trampa no es hipotética.
    //
    // Si esto se contestara solo con "¿tu cuenta es el negocio?", el mesero
    // dejaría de poder tomar pedidos EN SILENCIO: la app no enseña el error de
    // permisos, simplemente se queda la pantalla vacía y nadie sabe por qué.
    //
    // Vive aquí arriba, suelta, porque la contestan DOS bloques —los pedidos y
    // las reservas— y la SEGUNDA LEY prohíbe dos calculadoras del mismo proceso:
    // si se escribiera en los dos sitios, uno se quedaría viejo.
    //
    // El exists() va ANTES del get() a propósito: preguntar por una ficha que no
    // existe da error, y un error aquí tumbaría la condición entera.
    //
    // Y mira 'activo' (añadido el 24-ago-2026). Antes quien lo miraba era la APP
    // —o sea el lado de fuera, el que el atacante controla—, así que al empleado
    // despedido no se le caía la llave: seguía leyendo y cambiando los pedidos
    // del negocio sin pasar por la app. Medido: la única ficha real (JUAN) tiene
    // activo:true, así que esto no le quita nada a nadie que trabaje hoy. El
    // valor por defecto es 'true' para que una ficha vieja sin el campo entre.
    function esDelNegocio(negocioId) {
      return request.auth != null && (
        request.auth.uid == negocioId ||
        (exists(/databases/$(database)/documents/empleados/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/empleados/$(request.auth.uid)).data.get('restauranteId', '') == negocioId &&
         get(/databases/$(database)/documents/empleados/$(request.auth.uid)).data.get('activo', true) == true)
      );
    }

    match /usuarios/{userId} {
      // ── REGLA 1 · LA LLAVE MAESTRA ──────────────────────────────────────────
      // Hasta el 23-ago-2026 el dueño de una ficha podía escribir CUALQUIER campo
      // de la suya, incluido 'rol'. Con eso cualquiera se nombraba superadmin en
      // diez segundos. Y el remate: hay 12 reglas que preguntan "¿eres admin?"
      // leyendo ese mismo campo — le preguntaban al carnet que rellena el visitante.
      //
      // Medido el 23-ago-2026: de las TRES apps, NINGUNA escribe estos cuatro
      // campos sobre usuarios/{uid}. Las 3 escrituras de 'activo' de la app del
      // conductor van a la colección 'conductores', que es otra. Por eso cerrar
      // esto no rompe nada.
      function camposDePoder() {
        return ['rol', 'activo', 'sanciones', 'sancionHasta'];
      }

      // ── EL CORREO SE PONE UNA VEZ Y NO SE MUEVE ─────────────────────────────
      // El correo de la ficha se escribe al registrarse (Login.js:146) y nunca más.
      // Medido el 23-ago-2026: NINGUNA pantalla de las tres apps lo cambia después
      // (MiPerfil solo nombre/teléfono/foto, Configuración solo sonido y avisos,
      // Seguridad solo el contacto de confianza, el alta de conductor no lo toca).
      //
      // Se congela porque el panel busca POR CORREO a quién dar poder o créditos y
      // se queda con el primer resultado sin avisar de duplicados (Superadmin.js:581
      // y :302). Quien se copiara en su ficha el correo de un jefe podía quedarse
      // con el ascenso ajeno. Medido: 3 fichas ya comparten correo — de pruebas, sin
      // rol, pero la puerta funcionaba.
      //
      // Va en lista APARTE de camposDePoder porque en el CREATE sí hay que dejarlo
      // escribir: si no, nadie puede volver a registrarse.
      function camposCongelados() {
        return ['email'];
      }

      // ── REGLA 7 · LA PLATA NO LA ESCRIBE EL TELÉFONO ────────────────────────
      // Medido el 24-ago-2026: $369.700 en créditos repartidos en 8 fichas, y
      // esta regla dejaba que cualquiera se escribiera su propio saldo. Se
      // habían cerrado 'rol', 'email' y 'activo'; el dinero se quedó abierto.
      //
      // Los tres caminos que lo escribían desde el celular —canjear un código
      // de recarga, la promoción, y los créditos de bienvenida del conductor—
      // se mudaron al servidor (functions: canjearCodigoRecarga,
      // reclamarPromocion, creditosDeBienvenida), que se salta estas reglas.
      // Cobrar la comisión ya lo hacía el servidor desde el principio.
      //
      // Va en lista propia y se bloquea TAMBIÉN en el create: medido, ninguna
      // de las tres apps crea una ficha de usuario con saldo. (La app de
      // aliados sí escribe 'creditos: 0' al registrar un negocio, pero eso es
      // la colección 'restaurantes', que es otra y no pasa por aquí.)
      function camposDePlata() {
        return ['creditos'];
      }

      // ── REGLA 6 · LA FICHA DE UNA PERSONA ES SUYA ────────────────────────────
      // Hasta el 23-ago-2026 cualquier usuario registrado leía TODAS las fichas.
      // Medido ese día: 10 fichas — 8 con teléfono, 8 con fecha de nacimiento,
      // 7 con FOTO DE LA CÉDULA y 8 con el contacto de emergencia.
      //
      // Lo que tenía atascado este candado: el registro pedía la LISTA entera para
      // ver si el celular estaba repetido (Login.js:106). Esa pregunta se mudó al
      // servidor (functions: celularDisponible), que contesta sí o no sin enseñar
      // nada. Comprobado: era la ÚNICA consulta de lista de las tres apps.
      //
      // 'get' = pedir UNA ficha. Cada quien la suya (App.js:237, MiPerfil.js:29,
      // Creditos.js:32, y las demás: todas usan user.uid).
      // 'list' = pedir el montón. Solo el panel.
      allow get: if request.auth != null && (request.auth.uid == userId || esAdmin());
      allow list: if esAdmin();

      // Caso 1 — el dueño escribe su propia ficha, menos los campos de poder.
      // Va primero a propósito: no gasta la lectura que cuesta el get() de abajo.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(camposDePoder().concat(camposDePlata()));
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(camposDePoder().concat(camposCongelados()).concat(camposDePlata()));

      // Caso 2 — un admin o superadmin sí puede tocarlo todo, en cualquier ficha.
      // Es la única vía para dar un rol (Superadmin.js:599) o sancionar
      // (Conductores.js:299). Cuesta una lectura, por eso va después.
      allow create, update: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
      );

      allow delete: if false;
    }
    match /viajes/{viajeId} {
      // ── REGLA 6 · UN VIAJE ES DE QUIEN VIAJA ─────────────────────────────────
      // Hasta el 23-ago-2026 cualquier usuario registrado leía LOS 91 viajes.
      // Medido ese día, los 91 llevan dentro: nombre y correo del pasajero, su
      // código de seguridad, la dirección de recogida, la de destino y sus
      // coordenadas exactas. 78 llevan además el teléfono del conductor.
      //
      // Se usa .get(campo, '') porque 13 viajes no tienen conductorId todavía, y
      // preguntar por un campo que no existe da error.
      function esMio() {
        return resource.data.get('pasajeroId', '') == request.auth.uid
            || resource.data.get('conductorId', '') == request.auth.uid;
      }
      // El MERCADO: los que están buscando taxi. El conductor TIENE que verlos —
      // es el negocio (AppConductor.js:847). Los 82 terminados o cancelados no
      // están aquí: esos dejan de verse.
      function enElMercado() {
        return resource.data.get('estado', '') in
          ['esperando', 'en_negociacion', 'confirmando', 'contraoferta'];
      }
      // El conductor que DEJÓ UNA OFERTA sigue viendo el viaje aunque lo pierda.
      // Sin esto, en cuanto el pasajero elige a otro, la app del que perdió deja de
      // poder mirar el viaje y la tarjeta se le queda pegada en la pantalla
      // (AppConductor.js:654 vigila el viaje justo para enterarse de que perdió).
      // OJO CON EL ORDEN: esta pregunta necesita un viaje CONCRETO. Cuando el panel
      // pide la LISTA entera no hay uno concreto y la comprobación revienta, así que
      // va la ÚLTIMA — para entonces el panel ya salió por esAdmin(). Comprobado: si
      // se pone antes, el panel se queda ciego.
      function dejoUnaOferta() {
        return exists(/databases/$(database)/documents/viajes/$(viajeId)/contraofertas/$(request.auth.uid));
      }
      allow read: if request.auth != null
        && (esMio() || enElMercado() || esAdmin() || dejoUnaOferta());
      allow create, update: if request.auth != null;
      allow delete: if false;
      // ── REGLAS 5 y 11 · EL CAJON PRIVADO DEL VIAJE ─────────────────────────
      // Aquí vive el código de seguridad. SOLO lo ve la pasajera que lo va a decir.
      // El conductor NO puede leerlo: pregunta si el que le dijeron es el bueno, y
      // esa comparación la hace el servidor (functions: verificarCodigoViaje).
      // Antes el código iba dentro del viaje y lo leía cualquiera que mirase el
      // mercado — o sea, no protegía de nada.
      match /privado/{docPrivado} {
        function elViaje() {
          return get(/databases/$(database)/documents/viajes/$(viajeId)).data;
        }
        allow read: if request.auth != null
          && (elViaje().get('pasajeroId', '') == request.auth.uid || esAdmin());
        // Se escribe UNA vez, al pedir el viaje, y no se vuelve a tocar: si se
        // pudiera cambiar, el impostor pondría el suyo.
        allow create: if request.auth != null
          && elViaje().get('pasajeroId', '') == request.auth.uid;
        allow update, delete: if false;
      }

      match /contraofertas/{conductorId} {
        // ── REGLA 2 · LA OFERTA LA FIRMA SU CONDUCTOR ────────────────────────
        // Hasta el 23-ago-2026 cualquiera podía escribir una oferta a nombre de
        // OTRO conductor. Con eso y una llamada a confirmarConductor se le
        // descontaba la comisión a un conductor que nunca ofertó, y encima quedaba
        // marcado como ocupado. Cerrar solo la función no bastaba: el atacante
        // podía hacerlo en su PROPIO viaje.
        allow read: if request.auth != null;
        // Ofertar: solo el conductor que firma (AppConductor.js:353 usa su uid).
        allow create: if request.auth != null && request.auth.uid == conductorId;
        // Cambiarla: su conductor (AppConductor.js:635) o el pasajero DE ESE viaje,
        // que marca como no vigentes las que perdieron (Solicitar.js:1050 y
        // SolicitarMensajeria.js:1062). Sin esto último se rompe elegir conductor.
        allow update: if request.auth != null && (
          request.auth.uid == conductorId ||
          request.auth.uid == get(/databases/$(database)/documents/viajes/$(viajeId)).data.pasajeroId
        );
        allow delete: if false;
      }
      match /mensajes/{mensajeId} {
        // ── REGLA 6 · EL CHAT ES DE LOS DOS QUE VIAJAN ──────────────────────
        // Hasta el 23-ago-2026 cualquier usuario registrado podía LEER el chat de
        // cualquier viaje, y además ESCRIBIR dentro haciéndose pasar por el
        // conductor o por la pasajera. Solo lo usan esos dos (Solicitar.js:740 y
        // :752, SolicitarMensajeria.js:745 y :757, AppConductor.js:1106 y :1118).
        function elViaje() {
          return get(/databases/$(database)/documents/viajes/$(viajeId)).data;
        }
        function vaEnEsteViaje() {
          return elViaje().get('pasajeroId', '') == request.auth.uid
              || elViaje().get('conductorId', '') == request.auth.uid;
        }
        allow read: if request.auth != null && (vaEnEsteViaje() || esAdmin());
        allow create, update: if request.auth != null && (vaEnEsteViaje() || esAdmin());
        allow delete: if false;
      }
    }
    match /conductores/{conductorId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.auth.uid == conductorId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
      );
      allow delete: if false;
    }
    match /calificaciones/{calId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /llamadas/{llamadaId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /codigos/{codigoId} {
      // ── REGLA 6 · LOS CODIGOS DE RECARGA NO SE LISTAN ────────────────────────
      // Hasta el 23-ago-2026 cualquier usuario registrado podía pedir la LISTA
      // entera y ver cuáles seguían sin usar. Medido ese día: 8 códigos, 3 sin
      // usar, por $100.800 de verdad.
      //
      // 'get' = pedir UN código por su nombre. Es lo que hace el canje
      // (Creditos.js:111), y sigue permitido: hay que saberse el código.
      // 'list' = pedir el montón. Solo el panel (App.js:367, Codigos.js:158).
      allow get: if request.auth != null;
      allow list: if esAdmin();
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /promociones/{promoId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      // EXCEPCION medida: el panel borra promociones (Promociones.js:155).
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
      );
      match /usos/{usoId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if false;
      }
    }
    match /anuncios/{anuncioId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
      );
      // EXCEPCION medida: el panel borra anuncios (Superadmin.js:541).
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
      );
    }
    match /config/{documentoConfig} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin';
      allow delete: if false;
    }
    match /logs/{logId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin';
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
      );
    }
    match /dispositivosBeneficio/{deviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /restaurantes/{restauranteId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.auth.uid == restauranteId ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin'
      );
      allow delete: if false;
    }
    // ── REGLA 9 · CADA PEDIDO ES DE SU CLIENTE Y DE SU RESTAURANTE ──────────
    // Hasta el 24-ago-2026 esto decía «allow read: if request.auth != null», o
    // sea: CUALQUIERA con una cuenta podía pedir la lista completa de pedidos.
    // Medido ese día: 29 pedidos, 17 con TELÉFONO Y DIRECCIÓN de personas
    // reales, $1.200.000 en total. No hacía falta ser listo: era una consulta.
    //
    // 'read' se parte en dos porque son dos permisos que no se parecen:
    //   · get  — mirar UN pedido del que ya sabes el número.
    //   · list — pedirlos MUCHOS de una. La fuga estaba aquí.
    //
    // Quién puede LISTAR: el negocio dueño de esos pedidos, y el panel. Las
    // cinco pantallas de aliados ya preguntan where('restauranteId','==', el
    // suyo), así que encajan sin tocarlas. El panel pide la colección entera
    // sin filtro: por eso esAdmin() va PRIMERO, para que la condición se pueda
    // resolver sin mirar los pedidos uno por uno.
    //
    // Quién puede mirar UNO: además, su cliente. El cliente encuentra el suyo
    // por el número que guarda en su propio teléfono; desde hoy los pedidos
    // NUEVOS llevan 'clienteId' y por ahí se le reconoce.
    //
    // Los 29 VIEJOS no tienen dueño y no se les puede inventar uno. Medido: 0
    // están activos (20 cerrados, 7 cancelados, 2 entregados), así que ningún
    // cliente está mirando uno ahora mismo. Se quedan visibles para su
    // restaurante y para el panel, que son quienes los necesitan. No se borran.
    match /pedidosRestaurantes/{pedidoId} {
      allow get: if request.auth != null && (
        resource.data.get('clienteId', '') == request.auth.uid ||
        esDelNegocio(resource.data.restauranteId) ||
        esAdmin()
      );
      allow list: if esAdmin() || esDelNegocio(resource.data.restauranteId);

      // Al crearlo, el pedido se FIRMA. Dos firmas valen, y son los dos únicos
      // sitios de todo el proyecto que crean pedidos:
      //   · el cliente de la app (Restaurantes.js) — pone su propio clienteId.
      //   · el restaurante tomando una mesa (Mesero.js) — es del negocio.
      allow create: if esAdmin() ||
        esDelNegocio(request.resource.data.restauranteId) ||
        (request.auth != null &&
         request.resource.data.get('clienteId', '') == request.auth.uid);

      // Al cambiarlo: su cliente, su restaurante o el panel. Y el pedido NO
      // puede cambiar de dueño ni de restaurante por el camino: si pudiera, la
      // firma de arriba no valdría nada — bastaría crear uno propio y después
      // apuntarlo al negocio ajeno para colarse dentro.
      allow update: if (esAdmin() ||
          esDelNegocio(resource.data.restauranteId) ||
          (request.auth != null &&
           resource.data.get('clienteId', '') == request.auth.uid)) &&
        request.resource.data.restauranteId == resource.data.restauranteId &&
        request.resource.data.get('clienteId', '') == resource.data.get('clienteId', '');

      allow delete: if false;
    }
    match /restaurantes/{restauranteId}/empleados/{empleadoId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    // ── REGLA 9 · LA FICHA DE EMPLEADO YA NO SE LA ESCRIBE CUALQUIERA ───────
    // Esto decía «allow create, update: if request.auth != null». O sea: quien
    // tuviera una cuenta se escribía su PROPIA ficha de empleado poniéndole el
    // negocio que quisiera. Con eso conseguía DOS cosas:
    //
    //   · Entrar a la app de aliados como personal de un negocio ajeno
    //     —aliados/App.js:73 le abre la sesión leyendo justo esta ficha—, ver
    //     el menú, las mesas y los pedidos, y ponerse a tomar pedidos.
    //   · Y desde el 24-ago-2026, además, burlar la regla de los pedidos: la
    //     pregunta esDelNegocio() le pregunta a ESTA ficha quién es empleado de
    //     quién. El candado de arriba se apoyaba en una llave falsificable.
    //
    // Es el mismo molde exacto de la REGLA 1: se le preguntaba al carnet que
    // rellena el visitante. No se supuso — se ejecutó contra el emulador y los
    // cuatro pasos del ataque pasaron, incluido leer teléfono y dirección.
    //
    // Quién las escribe DE VERDAD: solo el dueño, desde su pantalla de equipo
    // (aliados/Empleados.js:102 al crear, :79 al editar, :126 al activar o
    // desactivar). Esa pantalla ya está cerrada con llave —aliados/App.js:399
    // solo la abre si efDueno— y el dueño escribe con su propia sesión, así que
    // su uid ES el restauranteId que lleva la ficha. Medido el 24-ago-2026: 1
    // empleado real (JUAN, activo, del restaurante TWjNDorw...). Ninguna otra
    // app ni función las toca.
    match /empleados/{empleadoId} {
      // Cada quien lee la SUYA, y es lo primero que hace la app al entrar: sirve
      // para saber si quien llega es dueño o empleado (aliados/Login.js:88 y
      // aliados/App.js:73). Va primero porque no cuesta ninguna lectura.
      allow get: if request.auth != null && (
        request.auth.uid == empleadoId ||
        esDelNegocio(resource.data.restauranteId) ||
        esAdmin()
      );

      // La lista, solo la de su propio equipo (aliados/Empleados.js:46 y
      // aliados/PedidosDomicilio.js:92 — las dos ya filtran por restauranteId).
      allow list: if esAdmin() || esDelNegocio(resource.data.restauranteId);

      // Nombrar y editar: SOLO el dueño del negocio. Ojo, aquí se pregunta por
      // el dueño y no por esDelNegocio(): si valiera cualquiera del negocio, un
      // empleado se subiría los permisos a sí mismo o se reactivaría después de
      // que lo despidan, y volveríamos al carnet que rellena el visitante.
      allow create: if esAdmin() || (
        request.auth != null &&
        request.auth.uid == request.resource.data.get('restauranteId', '')
      );

      // Y la ficha no puede mudarse de negocio: sin esto, el dueño de un negocio
      // cualquiera crea una ficha suya y luego la apunta al negocio de al lado.
      //
      // El .get('restauranteId','') no es adorno: con acceso directo, una ficha a
      // la que le faltara el campo daría ERROR aquí, y un error niega a TODOS —
      // incluido el panel. Como borrar está prohibido (REGLA 12), esa ficha se
      // quedaría congelada para siempre y sin forma de repararla.
      //
      // La segunda mitad es la que salva los AVISOS del empleado: su propio
      // teléfono guarda el token del aviso push en SU ficha al entrar
      // (aliados/Notificaciones.js:22), y esa escritura sale con la sesión del
      // empleado, no con la del dueño. Sin este permiso se le apagaría el aviso
      // de «pedido nuevo» EN SILENCIO: ese catch solo escribe en la consola, así
      // que nadie se enteraría hasta que el restaurante empezara a perder pedidos.
      // Quien lee el token son las funciones del servidor (functions/index.js:95
      // y :172). Se le deja UN campo y nada más: con hasOnly no puede colar de
      // paso ni sus permisos ni el activo.
      allow update: if ((esAdmin() || (
          request.auth != null &&
          request.auth.uid == resource.data.get('restauranteId', '')
        )) &&
        request.resource.data.get('restauranteId', '') == resource.data.get('restauranteId', '')
      ) || (
        request.auth != null &&
        request.auth.uid == empleadoId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
      );

      allow delete: if false;
    }
    match /visitasDiarias/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /mesasInfo/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // ===== NUEVAS (agregadas) =====
    // ── REGLA 9 · CADA RESERVA ES DE SU CLIENTE Y DE SU AGENCIA ─────────────
    // El mismo agujero que los pedidos, y se tapa igual. Con una diferencia que
    // lo hace gratis: medido el 24-ago-2026 hay CERO reservas. No hay nada
    // viejo que se quede sin dueño, así que aquí la regla nace estricta.
    match /reservasTurismo/{reservaId} {
      allow get: if request.auth != null && (
        resource.data.get('clienteId', '') == request.auth.uid ||
        esDelNegocio(resource.data.agenciaId) ||
        esAdmin()
      );
      allow list: if esAdmin() || esDelNegocio(resource.data.agenciaId);

      allow create: if esAdmin() ||
        esDelNegocio(request.resource.data.agenciaId) ||
        (request.auth != null &&
         request.resource.data.get('clienteId', '') == request.auth.uid);

      allow update: if (esAdmin() ||
          esDelNegocio(resource.data.agenciaId) ||
          (request.auth != null &&
           resource.data.get('clienteId', '') == request.auth.uid)) &&
        request.resource.data.agenciaId == resource.data.agenciaId &&
        request.resource.data.get('clienteId', '') == resource.data.get('clienteId', '');

      allow delete: if false;
    }
    match /comprasInsumos/{compraId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    match /usosPromo/{usoId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
